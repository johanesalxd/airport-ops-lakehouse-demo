# Copy to .env and adjust. Used by scripts/*.sh
export PROJECT_ID="your-project-id"
# Optional. If blank, bootstrap.sh discovers it from PROJECT_ID.
export PROJECT_NUMBER=""
export REGION="us-central1"
# Optional. If blank, bootstrap.sh, teardown.sh, and upload_demo_data.sh use
# airport-ops-demo-${PROJECT_NUMBER}.
export RAW_BUCKET=""

# Existing reusable BigQuery connections. Create these before running bootstrap.sh.
export SPARK_CONNECTION="spark-etl-conn"          # type=SPARK, us-central1
export GEMINI_CONNECTION="gemini_conn"            # type=CLOUD_RESOURCE, us-central1
export BIGLAKE_CONNECTION="default-us-central1"   # type=CLOUD_RESOURCE, us-central1

# BigQuery connection service accounts. Retrieve each from BigQuery connection
# details or with: bq show --connection PROJECT_ID.REGION.CONNECTION_ID
export SPARK_CONN_SA="bqcx-PROJECT_NUMBER-...@gcp-sa-bigquery-consp.iam.gserviceaccount.com"
export GEMINI_CONN_SA="bqcx-PROJECT_NUMBER-...@gcp-sa-bigquery-condel.iam.gserviceaccount.com"
export BIGLAKE_CONN_SA="bqcx-PROJECT_NUMBER-...@gcp-sa-bigquery-condel.iam.gserviceaccount.com"

# Dataform. Create and connect the GCP Dataform repository manually first.
export DATAFORM_SA="dataform-airport"             # short name; @PROJECT created by bootstrap
export DATAFORM_REPO_ID="airport-ops-lakehouse-dataform"
# Documentation-only values for the manual Dataform repository Git connection.
export DATAFORM_GIT_URL="https://github.com/YOUR_GITHUB_USER/airport-ops-lakehouse-dataform.git"
export DATAFORM_GIT_BRANCH="main"
export DATAFORM_GIT_SECRET="dataform-git-token"   # Secret Manager secret id

# Composer
# The DAG bucket is discovered at runtime (config.dagGcsPrefix); no need to set it.
export COMPOSER_ENV="dev-airflow"

# Optional Pub/Sub streaming baggage demo
export PUBSUB_BAGGAGE_SCHEMA="baggage-scan-event"
export PUBSUB_BAGGAGE_TOPIC="baggage-events"
export PUBSUB_BAGGAGE_DLQ_TOPIC="baggage-events-dlq"
export PUBSUB_BAGGAGE_SUBSCRIPTION="baggage-events-bq-sub"

# Datasets (created in REGION)
export DS_BRONZE="airport_bronze"
export DS_SILVER="airport_silver"
export DS_GOLD="airport_gold"
export DS_SEMANTIC="airport_semantic"
export DS_AI="airport_ai"
export DS_CONTROL="airport_ops_control"
export DS_ASSERTIONS="dataform_assertions"
export DS_GOVERNANCE="airport_governance"         # self-contained RLS/CLS showcase
export DS_SHARE="airport_share"                    # curated shr_* views published via Analytics Hub

# Hub-and-spoke data-sharing showcase (BigQuery Analytics Hub).
# The publisher (hub) is this PROJECT_ID; it publishes a private Data Exchange
# listing over DS_SHARE. Subscribers (spokes) link the dataset in their own
# project and pay for their own queries (cost isolation).
# Analytics Hub location MUST match the shared dataset's region (REGION), not "US".
export AH_LOCATION="us-central1"
export ANALYTICS_HUB_EXCHANGE="partner_exchange"       # data exchange id (publisher project)
export ANALYTICS_HUB_LISTING="airport_ops_daily"       # listing id over DS_SHARE
export ANALYTICS_HUB_EXCHANGE_DISPLAY="Partner Data Exchange"
export ANALYTICS_HUB_LISTING_DISPLAY="Airport Operations - Curated Share"
# Subscriber (spoke) project that links the shared dataset and runs cost-isolated queries.
export SUBSCRIBER_PROJECT="your-subscriber-project-id"
# IAM principal whitelisted on the listing (data-owner "whitelisting"). Use an
# explicit prefix: user:/group:/serviceAccount:. A bare email defaults to user:.
export SUBSCRIBER_PRINCIPAL="user:you@your-domain.example"
# Name of the linked dataset created in the subscriber project on subscribe.
export SUBSCRIBER_LINKED_DATASET="airport_ops_shared"
# Optional audit-log sink for the data-sharing showcase (see docs/data-sharing.md).
# teardown.sh removes these best-effort; defaults match the docs if left unset.
export AUDIT_DATASET="sharing_audit"
export AUDIT_SINK="sharing_audit_sink"

# RLS/CLS governance showcase: existing Google Groups whose members test the
# admin (full/raw) vs sales (filtered/masked) views of staff_directory.
export ADMIN_GROUP="bq-rls-cls-dataform-admin@your-domain.example"
export SALES_GROUP="bq-rls-cls-dataform-sales@your-domain.example"
